\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces ТПМ-2, вид сверху (условно). Челнок и молоток сидят на одной U-образной раме, рама — на ползуне. В покое ползун прижат пружиной к нулевому упору; для мёртвого знака планка О отводит его до упора $b$ или $c$, выбор делает признак N. Щупы на раме читают код литеры с кодовой гребёнки челнока и тросами ставят упор спуска и сектора B, C (ред. 0.10). Красная точка — ось молотка.}}{11}{figure.caption.12}\protected@file@percent }
